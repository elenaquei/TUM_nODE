    "## a little harder test case : the Lorentz system\n",
    "def lorenz():\n",
    "    sigma = 10\n",
    "    beta = 8/3\n",
    "    rho = 28\n",
    "    def func(x_func, t):\n",
    "        #print(t)\n",
    "        x = x_func[0]\n",
    "        y = x_func[1]\n",
    "        z = x_func[2]\n",
    "        lor = np.array([sigma*(y-x), x*(rho - z)-y, x*y - beta*z])\n",
    "        return lor\n",
    "    def derivative(x_func, t):\n",
    "        x = x_func[0]\n",
    "        y = x_func[1]\n",
    "        z = x_func[2]\n",
    "        return np.array([[-sigma, sigma, 0],[rho-z, -1, -x],[y, x, -beta]])\n",
    "    return func, derivative"
   ]
