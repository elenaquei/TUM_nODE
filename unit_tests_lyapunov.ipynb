    "        x = x_func[0]\n",
    "        y = x_func[1]\n",
    "        z = x_func[2]\n",
    "        ross = np.array([-y-z, x+a*y, b+z*(x-c)])\n",
    "        return ross\n",
    "    def derivative(x_func, t):\n",
    "        x = x_func[0]\n",
    "        y = x_func[1]\n",
    "        z = x_func[2]\n",
    "        return np.array([[0, -1, -1],[1, a, 0],[z, 0, x-c]])\n",
